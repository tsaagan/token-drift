{
  "name": "whodrifted",
  "version": "0.1.0",
  "description": "What changed in each Claude Code release, measured from your own logs",
  "type": "module",
  "bin": {
    "whodrifted": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run check && npm run build",
    "check": "tsc --noEmit && vitest run && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dev": "tsx src/cli/index.ts"
  },
  "keywords": ["claude", "claude-code", "drift", "observability", "cli", "cost", "tokens", "anthropic", "ai-tools"],
  "author": "tsaagan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsaagan/whodrifted.git"
  },
  "homepage": "https://github.com/tsaagan/whodrifted#readme",
  "bugs": {
    "url": "https://github.com/tsaagan/whodrifted/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": ["dist"],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsx": "^4.0.0"
  }
}
